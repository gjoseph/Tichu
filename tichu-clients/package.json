{
  "name": "tichu-clients-root",
  "private": true,
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "husky": "catalog:"
  },
  "scripts": {
    "prepare": "cd .. && husky tichu-clients/.husky",
    "build": "pnpm run -r build",
    "test": "pnpm run -r test # ⚠️ tichu-web will run tests in watch mode when not on CI",
    "lint": "biome check .",
    "format": "biome format . --write",
    "term-client": "pnpm --filter tichu-term-client run start",
    "web": "pnpm --filter tichu-web run start",
    "web-storybook": "pnpm --filter tichu-web run storybook",
    "web-build-storybook": "pnpm --filter tichu-client-ts-lib run build && pnpm --filter tichu-web run build-storybook"
  }
}
